<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- 高危修复：桌面组件相关 Activity 一律加本签名权限（protectionLevel=signature，
         仅同签名应用自身可启动）。此前全是 exported=true 且无保护，任何第三方 App
         都能带参数拉起它们：零参数创建备忘（ACTION_CREATE_MEMO）、改写已知 id 的
         备忘录（EditMemoActivity）、篡改购物项勾选态等。桌面组件的 PendingIntent
         以本应用签名上下文执行，不受影响。 -->
    <permission
        android:name="com.example.beiwang.permission.WIDGET_ACTION"
        android:protectionLevel="signature" />

    <application
        android:name=".BeiwangApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Beiwang"
        tools:targetApi="35">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Beiwang">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 手写板：锁定横屏，写入完成后返回备忘录详情。 -->
        <activity
            android:name=".ui.memo.HandwriteActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Beiwang" />

        <!-- 桌面组件内编辑备忘录：对话框式 Activity，由 widget 的"编辑"按钮拉起。
             taskAffinity="" + noHistory 使其从桌面拉起时成为独立、短暂的浮层任务，
             不带动/复用应用主任务栈、不出现在最近任务，关掉即回到桌面（不会"进软件"）。 -->
        <activity
            android:name=".widget.EditMemoActivity"
            android:exported="false"
            android:theme="@style/Theme.Beiwang.Dialog"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- 桌面组件「＋」的添加弹窗：先选类型（备忘录 / 购物清单 / 待办），再在同一个对话框里填内容；
             保存后写本地库并立即触发同步。同样以独立、短暂的浮层任务呈现，关掉即回桌面。 -->
        <activity
            android:name=".widget.WidgetAddActivity"
            android:exported="false"
            android:theme="@style/Theme.Beiwang.Dialog"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- 桌面组件交互桥接：透明、无 UI、不进最近任务、独立任务栈。
             全部组件点击经此 Activity 处理，可跨 Force-stop 唤醒（启动 Activity 的 PendingIntent 不受 stopped 状态限制）。 -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- 桌面小组件（RemoteViews + AdapterViewFlipper，支持左右滑动切换三个看板） -->
        <receiver
            android:name=".widget.BeiwangAppWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/beiwang_widget_info" />
        </receiver>

        <!-- 组件看板数据源（三页：备忘录 / 购物清单 / 待办）。
             BIND_REMOTEVIEWS 防止第三方应用随意读取组件数据。 -->
        <service
            android:name=".widget.BeiwangWidgetService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>

</manifest>
